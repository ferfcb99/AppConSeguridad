<configuration>
    <!-- Appender para escribir en un archivo .log -->
    <appender name="FILE" class="ch.qos.logback.core.FileAppender">
        <!-- Ruta y nombre del archivo donde se guardarán los logs -->
        <file>logs/etl-process.log</file>
        <append>true</append>
        <encoder>
            <!-- Formato: Fecha [Hilo] Nivel Clase - Mensaje -->
            <pattern>%d{yyyy-MM-dd HH:mm:ss} [%thread] %-5level %logger{36} - %msg%n</pattern>
        </encoder>
    </appender>

    <!-- Appender opcional para seguir viendo los logs en la consola -->
    <appender name="STDOUT" class="ch.qos.logback.core.ConsoleAppender">
        <encoder>
            <pattern>%d{yyyy-MM-dd HH:mm:ss} %-5level %logger{36} - %msg%n</pattern>
        </encoder>
    </appender>

    <!-- Definir el nivel mínimo de log (INFO) y asociar los appenders -->
    <root level="INFO">
        <appender-ref ref="FILE" />
        <appender-ref ref="STDOUT" />
    </root>
</configuration>